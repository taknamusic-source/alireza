{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alireza",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "5a347563-0ed1-45a1-a64a-448fb6ddaf6b","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "7365faacdb0a48c192e0563259cd5737" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
